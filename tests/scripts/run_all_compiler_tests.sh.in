#!/bin/bash

#
# run_all_compiler_tests.sh - Unified Cross-Compiler Testing Runner for Phase 6 Testing Infrastructure
#
# This script orchestrates comprehensive compilation testing across multiple compilers
# with unified reporting and cross-compiler compatibility verification.
#
# Usage:
#   ./run_all_compiler_tests.sh [options]
#
# Options:
#   -h, --help        Show this help message
#   -v, --verbose     Enable verbose output
#   -s, --silent      Suppress all output except errors
#   -g, --gcc-only    Run only GCC compilation tests
#   -c, --clang-only  Run only Clang compilation tests
#   -w, --warnings    Warning level (0-10, default: 8)
#   -o, --output      Specify output directory for reports (default: @CMAKE_BINARY_DIR@/reports)
#
# Features:
#   - Unified cross-compiler testing orchestration
#   - Automated warning aggregation across compilers
#   - Comprehensive compatibility verification
#   - Timestamped unified reports
#   - Integration with Phase 6 testing framework
#   - Fallback handling for missing compilers
#

## Project directories configured by CMake
PROJECT_SOURCE_DIR="@PROJECT_SOURCE_DIR@"
CMAKE_BINARY_DIR="@CMAKE_BINARY_DIR@"
DEFAULT_EXEDIR="@DEFAULT_EXEDIR@"
DEFAULT_SHARDIR="@DEFAULT_SHARDIR@"
DEFAULT_DEFAULTDIR="@DEFAULT_DEFAULTDIR@"
DEFAULT_LOGIN="@DEFAULT_LOGIN@"

set -euo pipefail

# Script configuration
SCRIPT_NAME="run_all_compiler_tests.sh"
SCRIPT_VERSION="2.1.0"
SCRIPT_DATE="2025-09-27"

# Default configuration
VERBOSE=false
SILENT=false
WARN_LEVEL=8
OUTPUT_DIR="${CMAKE_BINARY_DIR}/reports"
GCC_ONLY=false
CLANG_ONLY=false
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
UNIFIED_REPORT_FILE="${OUTPUT_DIR}/unified_compiler_test_report_${TIMESTAMP}.md"

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Test script paths (configured by CMake)
GCC_TEST_SCRIPT="${CMAKE_BINARY_DIR}/tests/scripts/test_gcc.sh"
CLANG_TEST_SCRIPT="${CMAKE_BINARY_DIR}/tests/scripts/test_clang.sh"

# Function to display help
show_help() {
    cat << EOF
run_all_compiler_tests.sh v${SCRIPT_VERSION} - Unified Cross-Compiler Testing Runner

USAGE:
    ./run_all_compiler_tests.sh [OPTIONS]

DESCRIPTION:
    Orchestrates comprehensive compilation testing across multiple compilers
    with unified reporting and cross-compiler compatibility verification.

OPTIONS:
    -h, --help        Show this help message and exit
    -v, --verbose     Enable verbose output during compilation
    -s, --silent      Suppress all output except critical errors
    -g, --gcc-only    Run only GCC compilation tests
    -c, --clang-only  Run only Clang compilation tests
    -w, --warnings    Warning level for both compilers (0-10, default: 8)
    -o, --output      Specify output directory for reports
                      Default: ${OUTPUT_DIR}

WARNING LEVELS:
    0: No warnings
    1: -Wall
    2: -Wall -Wextra
    3: -Wall -Wextra -Wpedantic
    4: Level 3 + -Wformat=2
    5: Level 4 + -Wconversion
    6: Level 5 + -Wsign-conversion
    7: Level 6 + -Wimplicit-fallthrough
    8: Level 7 + -Wstrict-prototypes (default)
    9: Level 8 + advanced warnings
    10: Level 9 + analysis tools

FEATURES:
    • Unified cross-compiler testing orchestration
    • Automated warning aggregation across compilers
    • Comprehensive compatibility verification
    • Timestamped unified reports saved to ${OUTPUT_DIR}
    • Integration with Phase 6 testing framework
    • Fallback handling for missing compilers

EXAMPLES:
    ./run_all_compiler_tests.sh                      # Test both GCC and Clang (default warning level 8)
    ./run_all_compiler_tests.sh -g                   # Test only GCC
    ./run_all_compiler_tests.sh -c                   # Test only Clang
    ./run_all_compiler_tests.sh -w 10                # Maximum warning level with analysis
    ./run_all_compiler_tests.sh -w 1 -v              # Basic warnings with verbose output
    ./run_all_compiler_tests.sh -v -o /tmp/reports   # Verbose with custom output

PHASE 6 INTEGRATION:
    This script is part of Phase 6.2: Cross-Compiler Test Infrastructure
    Results are automatically integrated with the Phase 6 testing framework.

COMPILER DEPENDENCIES:
    • GCC: Required for standard compilation testing
    • Clang: Optional but recommended for additional verification
    • CMake: Used for build system integration testing
EOF
}

# Function to log messages with timestamps
log_message() {
    local level="$1"
    local message="$2"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')

    if [[ "$SILENT" == false ]]; then
        case "$level" in
            "INFO")
                echo -e "${BLUE}[INFO]${NC} ${timestamp}: $message" >&2 ;;
            "WARN")
                echo -e "${YELLOW}[WARN]${NC} ${timestamp}: $message" >&2 ;;
            "ERROR")
                echo -e "${RED}[ERROR]${NC} ${timestamp}: $message" >&2 ;;
            "SUCCESS")
                echo -e "${GREEN}[SUCCESS]${NC} ${timestamp}: $message" >&2 ;;
        esac
    fi
}

# Function to create output directory if it doesn't exist
ensure_output_dir() {
    if [[ ! -d "$OUTPUT_DIR" ]]; then
        log_message "INFO" "Creating output directory: $OUTPUT_DIR"
        mkdir -p "$OUTPUT_DIR"
        if [[ $? -ne 0 ]]; then
            log_message "ERROR" "Unable to make ${OUTPUT_DIR}"
            exit 1
        fi
    fi
}

# Function to check compiler availability
check_compiler_availability() {
    local compiler_name="$1"
    local compiler_command="$2"

    if command -v "$compiler_command" &> /dev/null; then
        log_message "INFO" "$compiler_name found: $($compiler_command --version | head -n1)"
        return 0
    else
        log_message "WARN" "$compiler_name not found in PATH"
        return 1
    fi
}

# Function to run individual compiler test
run_compiler_test() {
    local compiler_name="$1"
    local test_script="$2"
    local output_args=""

    if [[ "$VERBOSE" == true ]]; then
        output_args="$output_args -v"
    elif [[ "$SILENT" == true ]]; then
        output_args="$output_args -s"
    fi

    output_args="$output_args -w $WARN_LEVEL -o $OUTPUT_DIR"

    log_message "INFO" "Running $compiler_name compilation test"

    if [[ -x "$test_script" ]]; then
        if $test_script $output_args; then
            log_message "SUCCESS" "$compiler_name test completed successfully"
            return 0
        else
            log_message "ERROR" "$compiler_name test failed"
            return 1
        fi
    else
        log_message "ERROR" "$compiler_name test script not found or not executable: $test_script"
        return 1
    fi
}

# Function to extract test results from compiler report
extract_test_results() {
    local report_file="$1"
    local compiler_name="$2"

    if [[ ! -f "$report_file" ]]; then
        echo "NOTFOUND|0|0|0"
        return
    fi

    local status=$(grep "Overall Status" "$report_file" | head -n1 | grep -o "✅ ALL TESTS PASSED\|❌.*FAILED" || echo "UNKNOWN")
    local tests_passed=$(grep "Tests Passed" "$report_file" | head -n1 | grep -o "[0-9]* / [0-9]*" || echo "0 / 0")
    local total_warnings=$(grep "Total Warnings" "$report_file" | head -n1 | grep -o "[0-9]*" || echo "0")
    local warning_level=$(grep "Warning Level" "$report_file" | head -n1 | grep -o "[0-9]*" || echo "0")

    echo "$status|$tests_passed|$total_warnings|$warning_level"
}

# Function to initialize unified report
init_unified_report() {
    ensure_output_dir

    cat > "$UNIFIED_REPORT_FILE" << EOF
# Unified Cross-Compiler Test Report

**Generated**: $(date '+%Y-%m-%d %H:%M:%S')
**Script**: ${SCRIPT_NAME} v${SCRIPT_VERSION}
**Phase**: 6.2 - Cross-Compiler Test Infrastructure
**Test Scope**: $([ "$GCC_ONLY" == true ] && echo "GCC Only" || [ "$CLANG_ONLY" == true ] && echo "Clang Only" || echo "GCC + Clang")
**Warning Level**: ${WARN_LEVEL} (Progressive warning analysis)

## Environment Information

**Operating System**: $(uname -s -r)
**Architecture**: $(uname -m)
**Available Compilers**:
EOF

    if check_compiler_availability "GCC" "gcc"; then
        echo "- GCC: $(gcc --version | head -n1)" >> "$UNIFIED_REPORT_FILE"
    else
        echo "- GCC: Not available" >> "$UNIFIED_REPORT_FILE"
    fi

    if check_compiler_availability "Clang" "clang"; then
        echo "- Clang: $(clang --version | head -n1)" >> "$UNIFIED_REPORT_FILE"
    else
        echo "- Clang: Not available" >> "$UNIFIED_REPORT_FILE"
    fi

    cat >> "$UNIFIED_REPORT_FILE" << EOF

## Test Configuration

**Warning Level Details**:
- Level ${WARN_LEVEL} provides comprehensive warnings
advanced warnings
- Both compilers use identical warning configurations for consistent comparison

## Test Execution Summary

EOF

    log_message "INFO" "Initialized unified report: $UNIFIED_REPORT_FILE"
}

# Function to update unified report with compiler results
update_unified_report() {
    local compiler_name="$1"
    local test_status="$2"
    local test_script_name="$3"
    local report_filename="$4"

    cat >> "$UNIFIED_REPORT_FILE" << EOF
### ${compiler_name} Test Results
**Status**: $([ "$test_status" == "0" ] && echo "✅ PASSED" || echo "❌ FAILED")
**Test Script**: \`${test_script_name}\`
**Detailed Report**: \`${report_filename}\`

EOF
}

# Function to finalize unified report
finalize_unified_report() {
    local gcc_status="$1"
    local clang_status="$2"
    local gcc_results="$3"
    local clang_results="$4"

    cat >> "$UNIFIED_REPORT_FILE" << EOF

## Cross-Compiler Compatibility Analysis

### Detailed Comparison Summary
| Compiler | Tests Passed | Total Warnings | Warning Level | Status |
|----------|-------------|----------------|---------------|--------|
EOF

    if [[ "$GCC_ONLY" != true ]]; then
        if [[ "$gcc_status" == "0" ]]; then
            IFS='|' read -r status tests_passed total_warnings warning_level <<< "$gcc_results"
            echo "| GCC      | $tests_passed  | $total_warnings  | $warning_level   | ✅ Tested |" >> "$UNIFIED_REPORT_FILE"
        else
            echo "| GCC      | N/A     | N/A            | N/A           | ❌ Failed |" >> "$UNIFIED_REPORT_FILE"
        fi
    fi

    if [[ "$CLANG_ONLY" != true ]]; then
        if [[ "$clang_status" == "0" ]]; then
            IFS='|' read -r status tests_passed total_warnings warning_level <<< "$clang_results"
            echo "| Clang    | $tests_passed | $total_warnings | $warning_level   | ✅ Tested |" >> "$UNIFIED_REPORT_FILE"
        else
            echo "| Clang    | N/A     | N/A            | N/A           | ❌ Failed |" >> "$UNIFIED_REPORT_FILE"
        fi
    fi

    local overall_status="PASSED"
    if [[ "$gcc_status" != "0" ]] || [[ "$clang_status" != "0" ]]; then
        overall_status="FAILED"
    fi

    cat >> "$UNIFIED_REPORT_FILE" << EOF

### Compatibility Assessment
$([ "$overall_status" == "PASSED" ] && echo "✅ **Excellent**: Both compilers tested successfully" || echo "⚠️ **Good**: Both compilers tested with different warning counts")


## Overall Test Summary

**Overall Status**: $([ "$overall_status" == "PASSED" ] && echo "✅ ALL TESTS PASSED" || echo "❌ SOME TESTS FAILED")
**Total Test Duration**: $(date '+%Y-%m-%d %H:%M:%S')
**Report Generation**: Completed successfully

### Next Steps
- Review individual compiler reports for detailed analysis
- Address any warnings or compilation failures found
- Integrate results with Phase 6 testing framework
- Proceed with Phase 6.3 development when all tests pass

### Generated Reports
EOF

    # List all report files in the output directory
    find "$OUTPUT_DIR" -name "*.md" -type f | sort | sed 's/.*\//- `/' | sed 's/$/`/' >> "$UNIFIED_REPORT_FILE"

    cat >> "$UNIFIED_REPORT_FILE" << EOF

---
**Generated by**: ${SCRIPT_NAME} v${SCRIPT_VERSION}
**Phase**: 6.2 - Cross-Compiler Test Infrastructure
**Date**: $(date '+%Y-%m-%d %H:%M:%S')
EOF
}

# Function to display final results
show_results() {
    if [[ "$SILENT" == false ]]; then
        echo ""
        echo "========================================"
        echo "Unified Cross-Compiler Test Complete"
        echo "========================================"
        echo "Unified report saved to: $UNIFIED_REPORT_FILE"
        echo ""
        echo "To view the unified report:"
        echo "  cat $UNIFIED_REPORT_FILE"
        echo ""
    fi
}

# Main function
main() {
    # Parse command line arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            -s|--silent)
                SILENT=true
                shift
                ;;
            -g|--gcc-only)
                GCC_ONLY=true
                shift
                ;;
            -c|--clang-only)
                CLANG_ONLY=true
                shift
                ;;
            -w|--warnings)
                WARN_LEVEL="$2"
                if [[ ! "$WARN_LEVEL" =~ ^([0-9]|10)$ ]]; then
                    log_message "ERROR" "Warning level must be 0-10"
                    exit 1
                fi
                shift 2
                ;;
            -o|--output)
                OUTPUT_DIR="$2"
                UNIFIED_REPORT_FILE="${OUTPUT_DIR}/unified_compiler_test_report_${TIMESTAMP}.md"
                shift 2
                ;;
            *)
                log_message "ERROR" "Unknown option: $1"
                echo "Use -h or --help for usage information"
                exit 1
                ;;
        esac
    done

    # Validate mutually exclusive options
    if [[ "$GCC_ONLY" == true ]] && [[ "$CLANG_ONLY" == true ]]; then
        log_message "ERROR" "Cannot specify both --gcc-only and --clang-only"
        exit 1
    fi

    # Initialize unified report
    log_message "INFO" "Starting unified cross-compiler testing"
    init_unified_report

    local gcc_status=0
    local clang_status=0
    local gcc_report_file=""
    local clang_report_file=""
    local gcc_results=""
    local clang_results=""

    # Run GCC tests
    if [[ "$CLANG_ONLY" != true ]]; then
        if run_compiler_test "GCC" "$GCC_TEST_SCRIPT"; then
            gcc_status=0
            gcc_report_file=$(find "$OUTPUT_DIR" -name "gcc_test_report_*.md" -type f | tail -n1)
            if [[ -n "$gcc_report_file" ]]; then
                gcc_report_file=$(basename "$gcc_report_file")
                gcc_results=$(extract_test_results "$OUTPUT_DIR/$gcc_report_file" "GCC")
            fi
        else
            gcc_status=1
        fi
        update_unified_report "GCC" "$gcc_status" "tests/scripts/test_gcc.sh" "$gcc_report_file"
    fi

    # Run Clang tests
    if [[ "$GCC_ONLY" != true ]]; then
        if run_compiler_test "Clang" "$CLANG_TEST_SCRIPT"; then
            clang_status=0
            clang_report_file=$(find "$OUTPUT_DIR" -name "clang_test_report_*.md" -type f | tail -n1)
            if [[ -n "$clang_report_file" ]]; then
                clang_report_file=$(basename "$clang_report_file")
                clang_results=$(extract_test_results "$OUTPUT_DIR/$clang_report_file" "Clang")
            fi
        else
            clang_status=1
        fi
        update_unified_report "Clang" "$clang_status" "tests/scripts/test_clang.sh" "$clang_report_file"
    fi

    # Finalize unified report
    finalize_unified_report "$gcc_status" "$clang_status" "$gcc_results" "$clang_results"

    # Show results
    show_results

    # Exit with appropriate status
    if [[ "$gcc_status" == "0" ]] && [[ "$clang_status" == "0" ]]; then
        log_message "SUCCESS" "All compiler tests completed successfully"
        exit 0
    else
        log_message "ERROR" "Some compiler tests failed"
        exit 1
    fi
}

# Execute main function if script is run directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi