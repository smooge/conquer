
ARG_ARRAY=(
    ""
    "-std=c2x -D_POSIX_C_SOURCE=200809L"
    "-Wall"
    "-Wextra"
    "-Wpedantic"
    "-Wformat"
    "-Wformat=2"
    "-Wconversion"
    "-Wimplicit-fallthrough"
    "-Wsign-conversion"
    "-Wstrict-prototypes"
    "-Wold-style-declaration"
    "-Wold-style-definition"
    "-Wtraditional"
    "-Wtraditional-conversion"
    "-fanalyzer"
)

# Homebrew version
if [[ -f /opt/homebrew/bin/gcc-15 ]]; then
    GCC="/opt/homebrew/bin/gcc-15"
elif [[ -f /usr/bin/gcc ]]; then
    GCC="/usr/bin/gcc"
else
    echo "NO GCC FOUND"
    exit
fi

GCC_BASE="-O2 -g "

count=0
for args in "${ARG_ARRAY[@]}"; do
    GCC_ARGS="${GCC_ARGS} ${args} "
    FILE=/tmp/gcc_errors_${count}
    /bin/rm -f ${FILE}
    touch ${FILE}
    for file in *.c *.h; do
	${GCC} ${GCC_BASE} ${GCC_ARGS} -c ${file} -o /tmp/foo.o >> ${FILE} 2>&1
    done
    count=$((count + 1))
done
